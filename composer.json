{
    "name": "npowest/garden-helper",
    "description": "Emum, Collection, Functions for NPOWEST Garden",
    "license": "MIT",
    "type": "library",
    "version": "1.0.9",
    "authors": [
        {
            "name": "Virus3D",
            "email": "viisto@yandex.ru"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.44",
        "nunomaduro/phpinsights": "^2.11",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "squizlabs/php_codesniffer": "^3.10",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan-symfony": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Npowest\\GardenHelper\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "nunomaduro/phpinsights": true,
            "friendsofphp/php-cs-fixer": true,
            "phpmd/phpmd": true,
            "phpstan/phpstan": true,
            "phpstan/phpstan-symfony": true,
            "phpstan/phpstan-strict-rules": true,
            "squizlabs/php_codesniffer": true
        },
        "platform": {
            "php": "8.2"
        }
    }
}
